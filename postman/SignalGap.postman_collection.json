{
  "info": {
    "name": "SignalGap REST API",
    "description": "SignalGap /gaps CRUD ve ek servis testleri. Sırasıyla çalıştırın; POST isteği gapId değişkenini kaydeder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "gapId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Sağlık kontrolü",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "02 - Oluştur (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('gapId', pm.response.json().data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Yedek kontrolü\",\n  \"description\": \"Son test kaydı bulunamadı\",\n  \"priority\": \"high\",\n  \"assignee\": \"Deniz\",\n  \"riskLevel\": \"high\",\n  \"category\": \"infrastructure\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/gaps",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "gaps"
          ]
        }
      }
    },
